{
  "type": "module",
  "private": true,
  "name": "@cyberxninja-omp/typescript-edit-benchmark",
  "version": "17.5.3",
  "description": "Edit benchmark suite using TypeScript source code mutations",
  "homepage": "https://omp.sh",
  "author": "Can Boluk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/can1357/oh-my-pi.git",
    "directory": "packages/typescript-edit-benchmark"
  },
  "exports": {
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts"
    },
    "./*.js": "./src/*.ts"
  },
  "scripts": {
    "check": "biome check . && bun run check:types",
    "check:types": "tsgo -p tsconfig.json --noEmit",
    "lint": "biome lint .",
    "test": "bun test --parallel",
    "fix": "biome check --write --unsafe .",
    "fmt": "biome format --write .",
    "generate": "bun run src/generate.ts --typescript-dir /tmp/pi-mono-source",
    "edit-shapes": "bun run src/edit-shape-stats.ts"
  },
  "dependencies": {
    "@babel/generator": "catalog:",
    "@babel/parser": "catalog:",
    "@babel/traverse": "catalog:",
    "@babel/types": "catalog:",
    "@cyberxninja-omp/hashline": "catalog:",
    "@cyberxninja-omp/pi-agent-core": "catalog:",
    "@cyberxninja-omp/pi-coding-agent": "catalog:",
    "@cyberxninja-omp/pi-utils": "catalog:",
    "diff": "catalog:",
    "@cyberxninja-omp/pi-natives": "catalog:",
    "prettier": "catalog:",
    "regexp-tree": "catalog:",
    "@cyberxninja-omp/pi-ai": "catalog:",
    "@cyberxninja-omp/pi-tui": "catalog:"
  },
  "devDependencies": {
    "@types/babel__generator": "catalog:",
    "@types/babel__traverse": "catalog:",
    "@types/bun": "catalog:"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
